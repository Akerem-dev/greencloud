# Firebase runtime target
# Development must choose explicitly. Use npm run dev:isolated for the safe
# emulator-only path; it overrides this value to true and forces demo-greencloud.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Firebase Web App configuration used only when the target above is false.
# Copy this file to .env.local and replace every required production value.

# Required for an intentional real Firebase connection
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Optional for the current Auth + Realtime Database implementation
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional local emulator overrides. The committed firebase.json defaults are
# 127.0.0.1 with Auth 9099, Database 9000 and Functions 5001.
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
NEXT_PUBLIC_FIREBASE_DATABASE_EMULATOR_PORT=9000
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001
